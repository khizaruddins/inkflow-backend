PORT=4000
NODE_ENV=development

# Database Connection String (Local MongoDB)
DATABASE_URL="mongodb://127.0.0.1:27017/inkflow?replicaSet=rs0&directConnection=true"

# JWT Authentication Configuration
JWT_ACCESS_SECRET="inkflow_jwt_access_super_secret_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="inkflow_jwt_refresh_super_secret_key_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Upload Provider Configuration (local, s3, cloudinary, supabase)
STORAGE_PROVIDER="local"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
