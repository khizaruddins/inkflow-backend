datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------
enum Role {
  ADMIN
  WRITER
  READER
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_REVISION
  PUBLISHED
  SCHEDULED
  ARCHIVED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostVisibility {
  PUBLIC
  PRIVATE
  MEMBERS_ONLY
}

enum ReportStatus {
  UNDER_EVALUATION
  DELETED
  DISMISSED
}

enum NotificationType {
  CLAP
  RESPONSE
  REPLY
  FOLLOW
  PRIVATE_SHARE
  EDITORIAL_FLAG
}

enum PrivateLockType {
  NONE
  PIN
  PASSWORD
}

enum PrivateAccessStatus {
  ACTIVE
  CONSUMED
  REVOKED
}

enum CollabMode {
  FREE_FLOW
  APPROVAL_REQUIRED
}

enum CollabSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  PENDING_DELETION
}

enum DeletionRequestStatus {
  PENDING
  CANCELLED
  COMPLETED
}

enum PostReportReason {
  ABUSIVE
  INAPPROPRIATE
  FALSE_CLAIM
  OTHER
}

enum PostReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  email                String               @unique
  name                 String
  username             String               @unique
  avatar               String
  bio                  String?
  role                 Role                 @default(READER)
  status               UserStatus           @default(ACTIVE)
  pausedAt             DateTime?
  suspendedAt          DateTime?
  suspensionReason     String?
  deletionRequestedAt  DateTime?
  deletionScheduledAt  DateTime?
  masterPrivatePassword String?              // Encrypted password set by user for private stories
  
  followersCount       Int                  @default(0)
  followingCount       Int                  @default(0)
  followingUserIds     String[]             @default([]) @db.ObjectId
  
  posts                Post[]               @relation("AuthorPosts")
  comments             Comment[]            @relation("UserComments")
  readingLists         ReadingList[]
  bookmarks            Bookmark[]
  highlights           Highlight[]
  history              ReadingHistory[]
  notifications        Notification[]       @relation("UserNotifications")
  reports              Report[]             @relation("Reporter")
  creatorApplications     CreatorApplication[]
  postClaps               PostClap[]
  privateAccesses         PrivatePostAccess[]  @relation("PrivateAccessRecipient")
  grantedPrivateAccesses  PrivatePostAccess[]  @relation("PrivateAccessGrantor")
  collaborations          PostCollaborator[]   @relation("UserPostCollaborations")
  collabSuggestions       PostSuggestion[]     @relation("UserPostSuggestions")
  deletionRequests        AccountDeletionRequest[]
  postReports             PostReport[]         @relation("PostReporter")

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model CreatorApplication {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  userId        String            @db.ObjectId
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sampleTitle   String
  sampleContent String
  motivation    String
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  color       String?
  posts       Post[]
  createdAt   DateTime @default(now())
}

model Tag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  postIds   String[] @db.ObjectId
  posts     Post[]   @relation(fields: [postIds], references: [id])
  createdAt DateTime @default(now())
}

model Post {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  subtitle           String?
  slug               String           @unique
  excerpt            String
  content            String           // HTML / TipTap Content
  coverImage         String

  authorId           String           @db.ObjectId
  author             User             @relation("AuthorPosts", fields: [authorId], references: [id])

  categoryId         String           @db.ObjectId
  category           Category         @relation(fields: [categoryId], references: [id])

  tagIds             String[]         @db.ObjectId
  tags               Tag[]            @relation(fields: [tagIds], references: [id])

  status                         PostStatus          @default(DRAFT)
  visibility                     PostVisibility      @default(PUBLIC)
  secretPasswordHash             String?             // Hashed PIN or password for private story access
  privateLockType                PrivateLockType?    @default(NONE)
  shareToken                     String?             // Random secret token for private sharing URL
  allowLinkPasswordAccess        Boolean?            @default(true)
  requirePasswordForGrantedUsers Boolean?            @default(false)
  requireFollowerToView          Boolean?            @default(false)
  reviewFeedback                 String?             // Admin feedback notes for revision

  readingTimeMinutes Int              @default(3)
  wordCount          Int              @default(0)
  characterCount     Int              @default(0)
  clapsCount         Int              @default(0)
  viewsCount         Int              @default(0)
  sharesCount        Int              @default(0)
  commentsCount      Int              @default(0)

  isFeatured         Boolean          @default(false)
  isPinned           Boolean          @default(false)
  toc                Json?            // Table of contents structure
  seo                Json?            // Meta title, description, keywords, ogImage

  versions           PostVersion[]
  comments           Comment[]
  bookmarks          Bookmark[]
  highlights         Highlight[]
  history            ReadingHistory[]
  postClaps          PostClap[]
  privateAccesses    PrivatePostAccess[]
  collaborators      PostCollaborator[]
  suggestions        PostSuggestion[]
  postReports        PostReport[]

  collabMode         CollabMode?         @default(FREE_FLOW)
  collabInviteToken  String?

  publishedAt        DateTime?
  scheduledAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([shareToken])
  @@index([collabInviteToken])
}

model PrivatePostAccess {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  postId        String              @db.ObjectId
  post          Post                @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId        String              @db.ObjectId
  user          User                @relation("PrivateAccessRecipient", fields: [userId], references: [id], onDelete: Cascade)

  grantedById   String              @db.ObjectId
  grantedBy     User                @relation("PrivateAccessGrantor", fields: [grantedById], references: [id], onDelete: Cascade)

  oneTimeView   Boolean             @default(false)
  hasViewed     Boolean             @default(false)
  viewCount     Int                 @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?

  passcodeHash    String?
  passcodeType    PrivateLockType     @default(NONE)
  requirePassword Boolean?

  status          PrivateAccessStatus @default(ACTIVE)
  revokedAt       DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([postId, userId])
  @@index([userId, status])
}

model PostVersion {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  postId     String   @db.ObjectId
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title      String
  content    String
  authorName String
  savedAt    DateTime @default(now())
}

model Comment {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  postId     String    @db.ObjectId
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  authorId   String    @db.ObjectId
  author     User      @relation("UserComments", fields: [authorId], references: [id])

  content    String    // HTML / Rich Text with links, bold, italic
  clapsCount Int       @default(0)

  parentId   String?   @db.ObjectId
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    Comment[] @relation("CommentReplies")

  reports    Report[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ReadingList {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isPrivate   Boolean  @default(true)
  postIds     String[] @db.ObjectId
  notes       Json?    // Key-value pairs: { [postId]: "custom reader note" }

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Highlight {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  text      String   // Highlighted quote text
  title     String?  // Optional name / label for note
  note      String?  // Optional description / thoughts
  createdAt DateTime @default(now())
}

model ReadingHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())
}

model Report {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  commentId     String       @db.ObjectId
  comment       Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  reporterId    String       @db.ObjectId
  reporter      User         @relation("Reporter", fields: [reporterId], references: [id])

  reasons       String[]     // ["Harassment", "Spam", "Rules Violation", "AI-generated"]
  blockedAuthor Boolean      @default(false)
  status        ReportStatus @default(UNDER_EVALUATION)
  createdAt     DateTime     @default(now())
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  recipientId String           @db.ObjectId
  recipient   User             @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  type        NotificationType
  actorId     String           @db.ObjectId
  postId      String?          @db.ObjectId
  message     String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

model PostClap {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
}

model PostCollaborator {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  postId       String    @db.ObjectId
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       String    @db.ObjectId
  user         User      @relation("UserPostCollaborations", fields: [userId], references: [id], onDelete: Cascade)
  canEdit      Boolean   @default(true)
  invitedById  String    @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([postId, userId])
  @@index([userId])
}

model PostSuggestion {
  id               String                 @id @default(auto()) @map("_id") @db.ObjectId
  postId           String                 @db.ObjectId
  post             Post                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId           String                 @db.ObjectId
  user             User                   @relation("UserPostSuggestions", fields: [userId], references: [id], onDelete: Cascade)
  title            String?
  originalContent  String
  suggestedContent String
  diffSummary      String?
  status           CollabSuggestionStatus @default(PENDING)
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedById     String?                @db.ObjectId
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([postId, status])
}

model AccountDeletionRequest {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                 @db.ObjectId
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail    String
  userName     String
  status       DeletionRequestStatus  @default(PENDING)
  requestedAt  DateTime               @default(now())
  scheduledFor DateTime               // requestedAt + 30 days
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status, scheduledFor])
}

model PostReport {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  postId      String            @db.ObjectId
  post        Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId  String            @db.ObjectId
  reporter    User              @relation("PostReporter", fields: [reporterId], references: [id])
  reason      PostReportReason
  customNote  String?
  adminNote   String?
  status      PostReportStatus  @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([postId, status])
}
